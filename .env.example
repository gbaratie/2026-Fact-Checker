# Database (Neon en prod, Postgres local via docker-compose)
DATABASE_URL=postgresql+asyncpg://factchecker:factchecker@localhost:5432/factchecker

# YouTube Data API v3 (https://console.cloud.google.com/)
YOUTUBE_API_KEY=

# Secret pour déclencher l'ingestion manuellement
INGESTION_SECRET=change-me-in-production

# Origines CORS autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,https://your-username.github.io

# Frontend uniquement
VITE_API_URL=http://localhost:8000
